{
  "metadata": {
    "projectType": "xwalk"
  },
  "templates": [
    {
      "name": "home",
      "urls": [
        "https://www.cnv.org/"
      ],
      "representativeUrl": "https://www.cnv.org/",
      "description": "City of North Vancouver homepage: rotating banner, feature boxes, news list and quick links",
      "urlPattern": "/",
      "blocks": [
        {
          "name": "carousel-banner",
          "instances": [
            "#home-top-banner .banners",
            "#banners"
          ]
        },
        {
          "name": "cards-feature",
          "instances": [
            ".homeCTAs"
          ]
        },
        {
          "name": "cards-news",
          "instances": [
            ".homeNewsPanel > div:has(.eventItem)"
          ]
        },
        {
          "name": "columns-links",
          "instances": [
            ".home-links"
          ]
        }
      ],
      "sections": [
        {
          "id": "rc5",
          "name": "Home Banner Slideshow",
          "selector": [
            "#home-banner-background",
            "#home-top-banner"
          ],
          "style": null,
          "blocks": [
            "carousel-banner"
          ],
          "defaultContent": []
        },
        {
          "id": "rc6",
          "name": "Feature Boxes",
          "selector": [
            "#content-columns > div.container:has(.homeCTAs)",
            "#content-columns > div.container:nth-of-type(3)"
          ],
          "style": null,
          "blocks": [
            "cards-feature"
          ],
          "defaultContent": []
        },
        {
          "id": "rc8",
          "name": "News, Quick Links and Council Meetings",
          "selector": [
            "#content-columns > div.container:has(.homeNewsPanel)",
            "#content-columns > div.container:nth-of-type(5)"
          ],
          "style": null,
          "blocks": [
            "cards-news",
            "columns-links"
          ],
          "defaultContent": [
            ".homeNewsPanel .firstLineTitle"
          ]
        }
      ]
    }
  ]
}
